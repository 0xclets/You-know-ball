# Local development only. Replace every placeholder before use.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://ykb:ykb_local_password@localhost:5432/ykb?schema=public
REDIS_URL=redis://localhost:6379
OTP_HMAC_SECRET=replace-with-random-secret-at-least-32-characters
ACCESS_TOKEN_SECRET=replace-with-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Aggregate worst-case payout exposure per market; this is not a per-user stake limit
MAX_MARKET_LIABILITY_NAIRA=50000000
OTP_RESEND_COOLDOWN_SECONDS=60

# Optional: verified phone number granted administrator role after OTP login
ADMIN_PHONE_E164=
# Optional SMS gateway adapter settings (provider-specific payload may need adapting)
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

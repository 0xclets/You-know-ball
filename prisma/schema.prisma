generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  USER
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}
enum WalletKind {
  BONUS
  CASH
}
enum OtpPurpose {
  SIGN_IN
  SIGN_UP
}
enum LedgerAccountKind {
  USER_BONUS
  USER_CASH
  PLATFORM_BONUS_CLEARING
  PLATFORM_CASH_CLEARING
  PLATFORM_FEE_REVENUE
}
enum LedgerTransactionType {
  SIGNUP_BONUS
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_PAYOUT
  REFUND
  ADJUSTMENT
}
model User {
  id String @id @default(cuid())
  phoneE164 String @unique @map("phone_e164") @db.VarChar(16)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  status UserStatus @default(ACTIVE)
  role UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  otpChallenges OtpChallenge[]
  refreshTokens RefreshToken[]
  walletAccounts WalletAccount[]
  bonusGrants BonusGrant[]
  marketPositions MarketPosition[]
  marketTrades MarketTrade[]
  @@map("users")
}
model OtpChallenge {
  id String @id @default(cuid())
  phoneE164 String @map("phone_e164") @db.VarChar(16)
  purpose OtpPurpose
  codeDigest String @map("code_digest") @db.VarChar(128)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  userId String? @map("user_id")
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([phoneE164, purpose, requestedAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}
model RefreshToken {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique @map("token_hash") @db.VarChar(128)
  familyId String @map("family_id") @db.VarChar(64)
  parentTokenId String? @map("parent_token_id")
  replacedById String? @map("replaced_by_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  @@index([familyId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}
model LedgerAccount {
  id String @id @default(cuid())
  kind LedgerAccountKind
  userId String? @map("user_id")
  currency String @default("NGN") @db.Char(3)
  wallet WalletAccount?
  entries LedgerEntry[]
  @@index([userId, kind])
  @@map("ledger_accounts")
}
model WalletAccount {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind WalletKind
  currency String @default("NGN") @db.Char(3)
  balanceKobo BigInt @default(0) @map("balance_kobo")
  ledgerAccountId String @unique @map("ledger_account_id")
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([userId, kind, currency])
  @@map("wallet_accounts")
}
model LedgerTransaction {
  id String @id @default(cuid())
  type LedgerTransactionType
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(128)
  reference String? @db.VarChar(128)
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  entries LedgerEntry[]
  @@map("ledger_transactions")
}
model LedgerEntry {
  id String @id @default(cuid())
  transactionId String @map("transaction_id")
  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId String @map("account_id")
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amountKobo BigInt @map("amount_kobo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}
model BonusGrant {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind String @default("SIGNUP") @db.VarChar(32)
  amountKobo BigInt @map("amount_kobo")
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([userId, kind])
  @@map("bonus_grants")
}

enum MarketStatus {
  DRAFT
  OPEN
  SUSPENDED
  CLOSED
  SETTLED
}
enum MarketOutcome {
  OVER
  UNDER
}
enum TradeSide {
  BUY
  SELL
}
model PlayerMarket {
  id String @id @default(cuid())
  playerName String @map("player_name") @db.VarChar(120)
  teamName String @map("team_name") @db.VarChar(120)
  opponentName String @map("opponent_name") @db.VarChar(120)
  competition String @db.VarChar(120)
  statKey String @map("stat_key") @db.VarChar(80)
  statLabel String @map("stat_label") @db.VarChar(120)
  lineValue Decimal @map("line_value") @db.Decimal(8, 2)
  kickoffAt DateTime @map("kickoff_at") @db.Timestamptz(6)
  status MarketStatus @default(DRAFT)
  liquidityNaira Decimal @default(50000) @map("liquidity_naira") @db.Decimal(14, 2)
  feeBps Int @default(200) @map("fee_bps")
  overShares Decimal @default(0) @map("over_shares") @db.Decimal(20, 2)
  underShares Decimal @default(0) @map("under_shares") @db.Decimal(20, 2)
  resolvedOutcome MarketOutcome? @map("resolved_outcome")
  settledAt DateTime? @map("settled_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  positions MarketPosition[]
  trades MarketTrade[]
  @@index([status, kickoffAt])
  @@index([playerName, kickoffAt])
  @@map("player_markets")
}
model MarketPosition {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  marketId String @map("market_id")
  market PlayerMarket @relation(fields: [marketId], references: [id], onDelete: Restrict)
  outcome MarketOutcome
  shares Decimal @default(0) @db.Decimal(20, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([userId, marketId, outcome])
  @@index([userId, updatedAt])
  @@map("market_positions")
}
model MarketTrade {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  marketId String @map("market_id")
  market PlayerMarket @relation(fields: [marketId], references: [id], onDelete: Restrict)
  outcome MarketOutcome
  side TradeSide
  shares Decimal @db.Decimal(20, 2)
  grossAmountKobo BigInt @map("gross_amount_kobo")
  feeKobo BigInt @map("fee_kobo")
  netAmountKobo BigInt @map("net_amount_kobo")
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([userId, createdAt])
  @@index([marketId, createdAt])
  @@map("market_trades")
}

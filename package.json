{
  "name": "ykb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev:api": "pnpm --filter @ykb/api start:dev",
    "dev:web": "pnpm --filter @ykb/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ykb/api test",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "prisma": "^6.10.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
